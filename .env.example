# ─────────────────────────────────────────────────────────────
# Database (MongoDB)
# ─────────────────────────────────────────────────────────────
# Local MongoDB. For docker-compose see docker-compose.yml.
DATABASE_URI=mongodb://127.0.0.1:27017/game-training-schedule

# ─────────────────────────────────────────────────────────────
# Payload
# ─────────────────────────────────────────────────────────────
# Generate with: `openssl rand -hex 32` (32+ chars, kept secret)
PAYLOAD_SECRET=replace-with-a-long-random-secret

# ─────────────────────────────────────────────────────────────
# Roles & invites
# ─────────────────────────────────────────────────────────────
# Код, который нужно ввести при регистрации, чтобы получить роль
# тренера-администратора. Сделайте его длинным и сложным.
# Оставьте пустым, чтобы полностью запретить самостоятельную
# регистрацию тренеров (тогда админов создаёт только другой админ
# через /admin или /cabinet/students не сможет — используйте /admin).
ADMIN_INVITE_CODE=

# ─────────────────────────────────────────────────────────────
# Reminders (cron)
# ─────────────────────────────────────────────────────────────
# За сколько часов до тренировки присылать напоминание (cron-задача).
REMINDER_LEAD_HOURS=24
# Секрет для защиты эндпоинта /api/cron/send-reminders.
# Сгенерируйте длинную случайную строку и дергайте эндпоинт внешним
# планировщиком примерно раз в час:
#   curl -H "Authorization: Bearer $CRON_SECRET" .../api/cron/send-reminders
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Email (SMTP via Nodemailer)
# ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email delivery in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Game Training Schedule
SMTP_FROM_ADDRESS=noreply@example.com

# ─────────────────────────────────────────────────────────────
# S3-compatible media storage
# ─────────────────────────────────────────────────────────────
# Works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, etc.
# Leave S3_BUCKET empty to fall back to local media storage.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Custom endpoint for non-AWS providers (R2 / MinIO). Leave empty for AWS S3.
S3_ENDPOINT=
# Set to `true` for MinIO / R2 / path-style providers.
S3_FORCE_PATH_STYLE=false
