# ─── Full config with SSL (used AFTER certificates are obtained) ─
# Rename this to eventfit.ru.conf after running ./deploy-ssl.sh

# ── HTTP redirects (both domains) ──
server {
    listen 80;
    server_name eventfit.ru www.eventfit.ru app.eventfit.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── eventfit.ru → landing page (HTTPS) ──
server {
    listen 443 ssl;
    http2 on;
    server_name eventfit.ru www.eventfit.ru;

    ssl_certificate     /etc/letsencrypt/live/eventfit.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/eventfit.ru/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 20m;

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}

# ── app.eventfit.ru → proxy to app (HTTPS) ──
server {
    listen 443 ssl;
    http2 on;
    server_name app.eventfit.ru;

    ssl_certificate     /etc/letsencrypt/live/eventfit.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/eventfit.ru/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 20m;

    # Everything → proxy to app. The Next.js middleware decides where to send
    # the visitor: logged-in users land on /cabinet, anonymous on /login.
    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
