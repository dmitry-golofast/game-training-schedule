# Normalize line endings to LF in the repository regardless of OS.
# On checkout, text files get LF; on commit, CRLF is converted to LF.
* text=auto eol=lf

# Ensure these binary-ish files are never mangled.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
