# ─────────────────────────────────────────────────────────────
# Slotory — Production Environment (slotory.ru)
# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in real values.

# ── Database (MongoDB, internal container network) ──
DATABASE_URI=mongodb://mongo:27017/slotory

# ── Payload ──
# Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# ── Server ──
NEXT_PUBLIC_SERVER_URL=https://slotory.ru

# ── Roles & invites ──
# Code for trainer self-registration. Leave empty to disable.
ADMIN_INVITE_CODE=

# ── Reminders (cron) ──
REMINDER_LEAD_HOURS=24
# Secret for /api/cron/send-reminders endpoint.
# Generate: openssl rand -hex 16
CRON_SECRET=

# ── Email (SMTP) ──
# Leave SMTP_HOST empty to disable email (console logger).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Slotory
SMTP_FROM_ADDRESS=noreply@slotory.ru

# ── S3-compatible media storage ──
# Leave S3_BUCKET empty to use local /media volume.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-1
# For Selectel/MinIO/R2, set endpoint:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
